# Firebase Admin (local). Keep service-account.json out of git.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Or paste the full service account JSON on one line:
# FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_DATABASE_ID=vapelizer

# Firebase web app (project: vapelizer-store)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=vapelizer-store.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=vapelizer-store
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=vapelizer-store.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=31403529621
NEXT_PUBLIC_FIREBASE_APP_ID=

# Auth.js / NextAuth secret. Generate one with: openssl rand -base64 32
# On the host, set NEXTAUTH_URL to the public https address
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# First admin created by `npm run seed`
ADMIN_EMAIL=admin@vapelizer.local
ADMIN_PASSWORD=changeme123

# Cloudinary — product, category, and banner image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. Cash on delivery works without these.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Digits only, country code included. Example: 919876543210
# Used until you save a number in /admin/settings.
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999
